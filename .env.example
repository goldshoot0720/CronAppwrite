# 本機測試用；請複製為 .env 後填入自己的值（.env 已被 .gitignore 忽略）
# 注意：這個檔案只給本機 shell 使用，GitHub Actions 走 Repository secrets。

# Appwrite 端點，例如 https://cloud.appwrite.io/v1（也可只填 https://cloud.appwrite.io）
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# 專案 ID（Console 左上角 Settings → Project ID）
APPWRITE_PROJECT_ID=

# API Key，需具備 rows.write（舊版為 documents.write）權限
APPWRITE_API_KEY=

# 資料庫 ID 與表 ID（表名稱叫 cron，ID 可能也是 cron）
APPWRITE_DATABASE_ID=
APPWRITE_TABLE_ID=cron

# table = TablesDB（預設）；collection = 舊版 collections / documents
APPWRITE_MODE=table

# 寫入資料時採用的時區
CRON_TZ=Asia/Taipei

# 設為 1 時只印出內容，不會真的寫入
DRY_RUN=0
